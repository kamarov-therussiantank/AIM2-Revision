#include "include\AIM.src"

void proc OnEnterLocation(char item, char cMech)
{
	StartScriptEvent("Events\EnterLocation.src", "OnEnterLocation", item);
 
	SetTimer("OnWorldTimeProcess", 0.5);
}

void proc OnWorldTimeProcess(char item)
{
	SetClanRelation("ORG_HIDDEN", "ORG_MERCATORS", -10);
	SetClanRelation("ORG_HIDDEN", "ORG_FANTOMS", -10);
	SetClanRelation("ORG_HIDDEN", "ORG_FREE", -10);
	SetClanRelation("ORG_HIDDEN", "ORG_FINDERS", -10);
	SetClanRelation("ORG_HIDDEN", "ORG_SURVIVORS", -10);
	SetClanRelation("ORG_MERCATORS", "ORG_FANTOMS", -10);
	SetClanRelation("ORG_MERCATORS", "ORG_FINDERS", -10);
	SetClanRelation("ORG_MERCATORS", "ORG_SURVIVORS", -10);
	SetClanRelation("ORG_FANTOMS", "ORG_FINDERS", -10);
	SetClanRelation("ORG_FANTOMS", "ORG_SURVIVORS", -10);
	SetClanRelation("ORG_FINDERS", "ORG_SURVIVORS", -10);	
	SetClanRelation("ORG_FINDERS", "ORG_FREE", -10);
	
	SetTimer("OnWorldTimeProcess2", 0.5);
}

void proc OnWorldTimeProcess2(char item)
{
	SetTimer("OnWorldTimeProcess", 0.5);
}

