#include "include\AIM.src"

void proc OnEnterLocation(char item)
{
	StartScriptEvent("Events\EnterLocation.src", "OnEnterLocation", item);

	if (!GetVar("location2.FIRST"))
	{
		CreateGroup("TS_GRP_MORRANDO");
		SetMechGeneration("TS_GRP_MORRANDO", 5);
		SetClanLider("ORG_TOLERANS", "TS_GRP_MORRANDO");

		CreateGroup("TS_GRP_VERCUS");
		SetMechGeneration("TS_GRP_VERCUS", 5);
		SetClanLider("ORG_NARGOON", "TS_GRP_VERCUS");

		SetClanRelation("ORG_SENTINELS", "ORG_PLAYER", 100);
		SetClanRelation("ORG_SENTINELS", "ORG_TOLERANS", 10);
		SetClanRelation("ORG_SENTINELS", "ORG_NARGOON", 10);
		SetClanRelation("ORG_SENTINELS", "ORG_FREE", 10);
		SetClanRelation("ORG_SENTINELS", "ORG_HIDDEN", 10);
		
		SetVar("location2.FIRST");
	}
	
	SetTimer("OnWorldTimeProcess", 0.5);
}

void proc OnWorldTimeProcess(char item)
{
	
	// The clan relations
	SetClanRelation("ORG_SENTINELS", "ORG_PLAYER", 100);
	SetClanRelation("ORG_SENTINELS", "ORG_TOLERANS", 10);
	SetClanRelation("ORG_SENTINELS", "ORG_NARGOON", 10);
	SetClanRelation("ORG_SENTINELS", "ORG_FREE", 10);
	SetClanRelation("ORG_SENTINELS", "ORG_HIDDEN", 10);
	SetClanRelation("ORG_NARGOON", "ORG_TOLERANS", -10);
	SetClanRelation("ORG_NARGOON", "ORG_HIDDEN", -10);
	SetClanRelation("ORG_NARGOON", "ORG_FREE", -10);
	SetClanRelation("ORG_TOLERANS", "ORG_HIDDEN", -10);
	SetClanRelation("ORG_INVADERS", "ORG_FREE", -10);
	SetClanRelation("ORG_INVADERS", "ORG_NARGOON", -10);
	SetClanRelation("ORG_INVADERS", "ORG_PLAYER", -10);
	
	SetTimer("OnWorldTimeProcess2", 0.5);
	
}

void proc OnWorldTimeProcess2(char item)
{
   
	SetTimer("OnWorldTimeProcess", 0.5);
	
}
