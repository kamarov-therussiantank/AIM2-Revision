#include "include\AIM.cpp"

void proc OnTryConvict(char cMech, char sOrg)
{   
	// Check if the mechmind is one of The Sentinels, if so = cancle convincing
	if (GetMechClan(cMech)=="ORG_SENTINELS") 
	{
		if (sOrg == CLAN)
		{
			MechSay(cMech, "MSG_SEN_RESISTANCE");
		}
		return;
	}
	// Check if the mechmind is one of The Arheys, if so = cancle convincing
	if (GetMechClan(cMech)=="ORG_ARHEYS") 
	{
		if (sOrg == CLAN)
		{
			MechSay(cMech, "MSG_ARH_RESISTANCE");
		}
		return;
	}
	SetMechClan(cMech, sOrg);
}
