			SetMechClan(sMech, "ORG_FREE");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
			return;
		}
		else if (RandomInt(35) == 0 && GetRating(RATING_WAR)>=2)
		{
			CreateMech(sMech, sPoint, "CFG_INVADER02");
			SetMechClan(sMech, "ORG_FREE");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
			return;
		}
		else if (RandomInt(30) == 0 && GetRating(RATING_WAR)>=2)
		{
			CreateMech(sMech, sPoint, "CFG_BIGINVADER01");
			SetMechClan(sMech, "ORG_FREE");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
			return;
		}
		else if (RandomInt(30) == 0 && GetRating(RATING_WAR)>=2)
		{
			CreateMech(sMech, sPoint, "CFG_BIGINVADER02");
			SetMechClan(sMech, "ORG_FREE");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
			return;
		}
		else
		{
			CreateMech(sMech, sPoint, "CFG_UNDER01");
			SetMechClan(sMech, "ORG_FREE");
