#include "Include\AIM.src"

void proc SpawnArenaEnemy(char item, char sLoc)
{
   //---Run Checkup---
	//if (!GetVar("ARENA.FIRST"))
	//{
	//	SetVar("ARENA.FIRST");
		
	//	SetVar("ARENA");
		
	//--- ARENA ENEMIES SPAWN LOGIC ---
	
	int iAmount;
	int i = 0;
	
	// Default spawn amount
	iAmount = 1;

	if (sLoc == "ARENA")
	{
		iAmount = 1;
	}

	while (i < iAmount)
	{
		char sMech;
		char sPoint;

		sPoint = "POINT_ARENA1";
		sMech= GetUniqueMechID();

		//The Forward
		if (RandomInt(10) == 0 && GetRating(RATING_WAR)>=7)
		{
			CreateMech(sMech, sPoint, "CFG_L10_M4_A_FORWARD");
			SetMechClan(sMech, "ORG_FORWARD");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
			return;
		}
		else if (RandomInt(10) == 0 && GetRating(RATING_WAR)>=6)
		{
			CreateMech(sMech, sPoint, "CFG_L10_M4_A_FORWARD_low");
			SetMechClan(sMech, "ORG_FORWARD");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
			return;
		}
		//The Ascends
		else if (RandomInt(15) == 0 && GetRating(RATING_WAR)>=5)
