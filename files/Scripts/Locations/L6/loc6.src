#include "include\AIM.src"

void proc OnEnterLocation(char item)
{
	StartScriptEvent("Events\EnterLocation.src", "OnEnterLocation", item);

	if (!GetVar("location6.FISRT"))
	{
		CreateGroup("TS_GRP_GAANTRO");
		SetMechGeneration("TS_GRP_GAANTRO", 5);
		SetClanLider("ORG_FINDERS", "TS_GRP_GAANTRO");
	
		SetVar("location6.FISRT");

		CreateGroup("MOXXAART");
		SetMechGeneration("MOXXAART", 4);
		SetMechClan("MOXXAART", "ORG_RECONERS");
		SetRelation("MOXXAART", "PLAYER", 10);
		
		SetClanRelation("ORG_SENTINELS", "ORG_PLAYER", 100);
		SetClanRelation("ORG_SENTINELS", "ORG_FINDERS", 10);
		SetClanRelation("ORG_SENTINELS", "ORG_ASCENDS", 10);
		SetClanRelation("ORG_SENTINELS", "ORG_FREE", 10);
		SetClanRelation("ORG_SENTINELS", "ORG_CARRIERS", 10); 
				
	}
	
	SetTimer("OnWorldTimeProcess", 0.5);
}

void proc OnWorldTimeProcess(char item)
{
	
	// The clan relations
	SetClanRelation("ORG_SENTINELS", "ORG_PLAYER", 100);
	SetClanRelation("ORG_SENTINELS", "ORG_FINDERS", 10);
	SetClanRelation("ORG_SENTINELS", "ORG_SURVIVORS", 10);
	SetClanRelation("ORG_SENTINELS", "ORG_FREE", 10);
	SetClanRelation("ORG_SENTINELS", "ORG_CARRIERS", 10); 
	SetClanRelation("ORG_FINDERS", "ORG_CARRIERS", -10);
	SetClanRelation("ORG_FINDERS", "ORG_FREE", -10);
	SetClanRelation("ORG_CARRIERS", "ORG_SURVIVORS", -10);
	SetClanRelation("ORG_CARRIERS", "ORG_FINDERS", -10);

	
	SetTimer("OnWorldTimeProcess2", 0.5);
}

void proc OnWorldTimeProcess2(char item)
{
	SetTimer("OnWorldTimeProcess", 0.5);
}
