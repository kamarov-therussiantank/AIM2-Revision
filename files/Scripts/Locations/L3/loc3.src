#include "include\AIM.src"

void proc OnEnterLocation(char item, char cMech)
{
	StartScriptEvent("Events\EnterLocation.src", "OnEnterLocation", item);

	if (!GetVar("location3.FISRT"))
	{
		CreateGroup("TS_GRP_FATALL");
		SetMechGeneration("TS_GRP_FATALL", 5);
		SetClanLider("ORG_ARHEYS", "TS_GRP_FATALL");	
		SetVar("location3.FISRT");
		
		SetClanRelation("ORG_SENTINELS", "ORG_PLAYER", 100);
		SetClanRelation("ORG_SENTINELS", "ORG_ARHEYS", -10);
		SetClanRelation("ORG_SENTINELS", "ORG_HIDDEN", -10);
		SetClanRelation("ORG_SENTINELS", "ORG_FIREHALF", 10);

	}	
	
	SetTimer("OnWorldTimeProcess", 0.5);
}

void proc OnWorldTimeProcess(char item)
{
	// The Sentinels relation towards other clans, and likewise
	SetClanRelation("ORG_SENTINELS", "ORG_PLAYER", 100);
	SetClanRelation("ORG_SENTINELS", "ORG_ARHEYS", -10);
	SetClanRelation("ORG_SENTINELS", "ORG_HIDDEN", -10);
	SetClanRelation("ORG_SENTINELS", "ORG_FORWARD", -10);
	SetClanRelation("ORG_SENTINELS", "ORG_FIREHALF", 10);
	
	// The Arheys relation towards other clans, and likewise
	SetClanRelation("ORG_ARHEYS", "ORG_FORWARD", -10);
	SetClanRelation("ORG_ARHEYS", "ORG_FREE", -10);
	SetClanRelation("ORG_ARHEYS", "ORG_PLAYER", -10);
	SetClanRelation("ORG_ARHEYS", "ORG_FIREHALF", -10);
	
	// The Hidden Ones relation towards other clans
	SetClanRelation("ORG_HIDDEN", "ORG_FORWARD", 10);
	
	SetTimer("OnWorldTimeProcess2", 0.5);
	
}

void proc OnWorldTimeProcess2(char item)
{
	SetTimer("OnWorldTimeProcess", 0.5);
}
