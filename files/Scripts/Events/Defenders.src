#include "include\aim.cpp"

void proc OnEnterLocation(char sLoc)
{
StartScriptEvent("Events\EnterLocation.src", "OnEnterLocation", sLoc);

// Create Sentinels
	
	int iAmount;
	int i = 0;
	iAmount = 10;
	
	
	while(i<iAmount)
	{
		char sMech;
		char sMech1;
		char config;
		char sPoint;
		  
		sPoint = "ROAD"+char(i+1);
		sMech = GetUniqueMechID();
		sMech1 = GetUniqueMechID();
	 
			CreateMech(sMech, sPoint, "CFG_DEFENDER01");
			SetMechClan(sMech, "ORG_SENTINELS");
			SetMechGuard(sMech, sPoint);
	   
			CreateMech(sMech1, sPoint, "CFG_DEFENDER03");
			SetMechClan(sMech1, "ORG_SENTINELS");
			SetMechGuard(sMech1, sPoint);
		
		i = i+1;
		
	}
}


