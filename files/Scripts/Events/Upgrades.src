#include "include\AIM.cpp"

void proc OnEnterBuild(char item)
{
	int typebuild;
	typebuild = GetBuildType(item);
	switch (typebuild)
	{
		//Equipment upgrade logic
		case 9:
		{
			int availableUpgrade;
			availableUpgrade= 0;
			
				//Engines
				//Ion Drive - upgrades (ST1-4)
				if(GetEquipLayer(EQIP_ENGINE)=="EQP_ION_DRIVE" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE)) >= 1)
				{
					Text("EQP_ION_DRIVE_UPGRADE1");
					availableUpgrade= 1;
				}
				if(GetEquipLayer(EQIP_ENGINE2)=="EQP_ION_DRIVE" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE2)) >= 1)
				{
					Text("EQP_ION_DRIVE_02_UPGRADE1");
					availableUpgrade= 1;
				}
				if(GetEquipLayer(EQIP_ENGINE)=="EQP_ION_DRIVE_ST2" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE)) >= 2)
				{
					Text("EQP_ION_DRIVE_UPGRADE2");
					availableUpgrade= 1;
				}
				if(GetEquipLayer(EQIP_ENGINE2)=="EQP_ION_DRIVE_ST2" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE2)) >= 2)
				{
					Text("EQP_ION_DRIVE_02_UPGRADE2");
					availableUpgrade= 1;
				}
				if(GetEquipLayer(EQIP_ENGINE)=="EQP_ION_DRIVE_ST3" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE)) >= 3)
				{
					Text("EQP_ION_DRIVE_UPGRADE3");
					availableUpgrade= 1;
				}
				if(GetEquipLayer(EQIP_ENGINE2)=="EQP_ION_DRIVE_ST3" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE2)) >= 3)
				{
					Text("EQP_ION_DRIVE_02_UPGRADE3");
					availableUpgrade= 1;
				}
				
				
				//Plasma Drive - upgrades (ST1-4)
				if(GetEquipLayer(EQIP_ENGINE)=="EQP_PLASMA_DRIVE" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE)) >= 1)
				{
					Text("EQP_PLASMA_DRIVE_UPGRADE1");
					availableUpgrade= 1;
				}
				if(GetEquipLayer(EQIP_ENGINE2)=="EQP_PLASMA_DRIVE" && GetEquipStandard(GetEquipLayer(EQIP_ENGINE2)) >= 1)
