//Upgrade accepted conditions

//Engines
//Ion Drive (ST1-4)
void proc ION1ENG2()
{
	DeleteText("EQP_ION_DRIVE_UPGRADE1");
	Text("EQP_ENGINE_UPGRADED");
	InstallEquipLayer(EQIP_ENGINE, "EQP_ION_DRIVE_ST2");
	AddAmount(AMOUNT_ENERGY, -5400);
}
