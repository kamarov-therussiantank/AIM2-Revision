#include "include\aim.cpp"

void proc OnEnterLocation(char sLoc)
{
StartScriptEvent("Events\EnterLocation.src", "OnEnterLocation", sLoc);

// Create Sinigr Servents
	
	int iAmount;
	int i = 0;
	iAmount = 25;
	
	
	while(i<iAmount)
	{
		char sMech;
		char config;
		char sPoint;
		  
		sPoint = "ROAD"+char(i+1);
		sMech = GetUniqueMechID();
	 
			CreateMech(sMech, sPoint, "CFG_SINYGR01");
			SetMechClan(sMech, "ORG_ARHEYS");
			SetMechGuard(sMech, sPoint);
			SetRelation(sMech, "PLAYER", -9);
		
		i = i+1;
		
	}
}

